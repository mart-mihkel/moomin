#!/usr/bin/env bash

log() { printf "\033[1;34m[%s]\033[0m %s\n" "$(date '+%H:%M:%S')" "$*"; }

WALLS=~/.cache/moomin/walls
THUMBS=~/.cache/moomin/thumbs

mkdir -p $WALLS
mkdir -p $THUMBS

log "Creating thumbnails..."
for WALL in $WALLS/*; do
    THUMB=$THUMBS/$(basename $WALL)
    if [[ -f $THUMB ]]; then
        continue
    fi

    log "Cropping $(basename $WALL)..."
    magick convert \
        -quiet \
        -strip $WALL \
        -thumbnail x540^ \
        -gravity center \
        -extent 330x500 \
        $THUMB 2>/dev/null
done

IMG=$(
    for WALL in $WALLS/*; do
        printf "$WALL\0icon\x1f$THUMBS/$(basename $WALL)\n"
    done | rofi -dmenu -config ~/.config/rofi/walls.rasi
)

if [[ -z $IMG ]]; then
    log "Pick cancelled"
    exit 1
fi

log "Setting wallpaper"
awww img $IMG --transition-type grow --transition-fps 60

log "Generating colors"
matugen image $IMG -m light --prefer saturation
