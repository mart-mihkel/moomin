configuration {
    show-icons: true;
}

@import "colors.rasi"

window {
    border: 0;
    fullscreen: true;
    background-color: @background;
}

mainbox {
    children: [listview];
}

listview {
    border: 0;
    columns: 7;
    spacing: 12px;
    padding: 275px 75px;
    scrollbar: false;
    flow: horizontal;
}

element {
    padding: 0;
    children: [element-icon];
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    border: 12px;
    border-color: transparent;
    background-color: transparent;
}

element-icon {
    expand: true;
    size: 330px 500px;
}
